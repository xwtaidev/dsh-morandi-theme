{
  "name": "@xwtaidev/dsh-theme-morandi",
  "version": "1.0.0",
  "type": "module",
  "description": "A restrained paper-and-ink Morandi theme for DeepSeek Harness.",
  "license": "MIT",
  "author": "xwtaidev",
  "repository": { "type": "git", "url": "git+https://github.com/xwtaidev/dsh-morandi-theme.git" },
  "homepage": "https://github.com/xwtaidev/dsh-morandi-theme#readme",
  "bugs": { "url": "https://github.com/xwtaidev/dsh-morandi-theme/issues" },
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "theme", "obsidian", "morandi"],
  "publishConfig": { "access": "public" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "LICENSE", "README.md", "test/*.test.js"],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-theme"]
    }
  }
}
